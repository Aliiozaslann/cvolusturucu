+/* SEO ve bilgi sayfaları */
+.seo-page-body {
+    min-height: 100vh;
+    background: #0b1120;
+    color: #f8fafc;
+}
+.seo-page-main {
+    width: min(1180px, 92%);
+    margin: 0 auto;
+    padding: 78px 0 84px;
+}
+.seo-page-hero {
+    max-width: 820px;
+    margin: 0 auto 52px;
+    text-align: center;
+}
+.seo-kicker {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    padding: 7px 14px;
+    border: 1px solid rgba(192, 132, 252, 0.35);
+    border-radius: 999px;
+    background: rgba(140, 82, 255, 0.12);
+    color: #c084fc;
+    font-size: 0.78rem;
+    font-weight: 800;
+    letter-spacing: 0.04em;
+}
+.seo-page-hero h1 {
+    margin: 18px 0 14px;
+    color: #ffffff;
+    font-size: clamp(2.1rem, 5vw, 3.7rem);
+    line-height: 1.08;
+    letter-spacing: -0.04em;
+}
+.seo-page-hero p {
+    max-width: 720px;
+    margin: 0 auto 24px;
+    color: #94a3b8;
+    font-size: 1.08rem;
+    line-height: 1.75;
+}
+.seo-cta {
+    display: inline-flex;
+    align-items: center;
+    gap: 9px;
+    padding: 12px 18px;
+    border-radius: 10px;
+    background: linear-gradient(135deg, #8c52ff, #a855f7);
+    color: #ffffff;
+    font-weight: 800;
+    text-decoration: none;
+    box-shadow: 0 8px 24px rgba(140, 82, 255, 0.28);
+    transition: transform 160ms ease, box-shadow 160ms ease;
+}
+.seo-cta:hover,
+.seo-cta:focus-visible {
+    color: #ffffff;
+    transform: translateY(-2px);
+    box-shadow: 0 12px 30px rgba(140, 82, 255, 0.4);
+}
+.seo-card-grid {
+    display: grid;
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+    gap: 16px;
+}
+.seo-template-card,
+.guide-card {
+    min-height: 220px;
+    padding: 22px;
+    border: 1px solid rgba(255, 255, 255, 0.1);
+    border-radius: 18px;
+    background: linear-gradient(160deg, rgba(15, 23, 42, 0.98), rgba(15, 23, 42, 0.74));
+    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.16);
+}
+.seo-template-number,
+.guide-card > span {
+    display: block;
+    margin-bottom: 22px;
+    color: #c084fc;
+    font-size: 0.78rem;
+    font-weight: 900;
+    letter-spacing: 0.12em;
+}
+.seo-template-card h2,
+.guide-card h2 {
+    margin: 0 0 10px;
+    color: #ffffff;
+    font-size: 1.2rem;
+}
+.seo-template-card p,
+.guide-card p {
+    margin: 0;
+    color: #94a3b8;
+    font-size: 0.93rem;
+    line-height: 1.65;
+}
+.seo-template-card a,
+.guide-card a,
+.seo-page-footer a {
+    color: #c084fc;
+    font-weight: 800;
+    text-decoration: none;
+}
+.seo-template-card a {
+    display: inline-flex;
+    align-items: center;
+    gap: 7px;
+    margin-top: 20px;
+    font-size: 0.86rem;
+}
+.seo-template-card a:hover,
+.seo-template-card a:focus-visible,
+.guide-card a:hover,
+.guide-card a:focus-visible,
+.seo-page-footer a:hover,
+.seo-page-footer a:focus-visible {
+    color: #e9d5ff;
+    text-decoration: underline;
+}
+.seo-template-slate { border-top: 3px solid #64748b; }
+.seo-template-navy { border-top: 3px solid #3b82f6; }
+.seo-template-teal { border-top: 3px solid #14b8a6; }
+.seo-template-magenta { border-top: 3px solid #ec4899; }
+.seo-template-emerald { border-top: 3px solid #10b981; }
+.seo-template-burgundy { border-top: 3px solid #e11d48; }
+.seo-template-aurora { border-top: 3px solid #8b5cf6; }
+.seo-template-copper { border-top: 3px solid #f59e0b; }
+.seo-page-footer {
+    width: min(1180px, 92%);
+    margin: 0 auto;
+    padding: 24px 0 34px;
+    border-top: 1px solid rgba(255, 255, 255, 0.1);
+    color: #64748b;
+    font-size: 0.88rem;
+    line-height: 1.7;
+    text-align: center;
+}
+.seo-page-footer strong { color: #ffffff; }
+.guide-grid {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 18px;
+}
+.guide-card { min-height: 245px; }
+.guide-card > span { color: #38bdf8; }
+.guide-callout {
