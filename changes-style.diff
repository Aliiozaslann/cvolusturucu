+/* ======================================================================
+   CVYAP TEK ÜST MENÜ — 5 CRAWLABLE SITE SECTIONS
+   ====================================================================== */
+.site-header {
+    width: 100%;
+    position: sticky;
+    top: 0;
+    z-index: 100;
+    background: rgba(11, 17, 32, 0.96);
+    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
+    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    backdrop-filter: blur(14px);
+}
+
+.site-header-inner {
+    width: min(1600px, 96%);
+    min-height: 70px;
+    margin: 0 auto;
+    padding: 12px 2%;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 28px;
+}
+
+.brand-logo-text-only {
+    gap: 0;
+    flex: 0 0 auto;
+}
+
+.brand-logo-text-only .brand-logo-text {
+    font-size: 1.8rem;
+    letter-spacing: -1.3px;
+}
+
+.site-nav {
+    display: flex;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 6px;
+    min-width: 0;
+}
+
+.site-nav-link {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-height: 38px;
+    padding: 8px 13px;
+    border: 1px solid transparent;
+    border-radius: 999px;
+    color: #cbd5e1;
+    text-decoration: none;
+    white-space: nowrap;
+    font-size: 0.88rem;
+    font-weight: 700;
+    line-height: 1;
+    transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease;
+}
+
+.site-nav-link:hover,
+.site-nav-link:focus-visible,
+.site-nav-link[aria-current="page"] {
+    color: #ffffff;
+    background: rgba(140, 82, 255, 0.18);
+    border-color: rgba(192, 132, 252, 0.45);
+    transform: translateY(-1px);
+}
+
+.site-nav-link-primary {
+    color: #ffffff;
+    background: linear-gradient(135deg, #8c52ff, #a855f7);
+    border-color: transparent;
+    box-shadow: 0 6px 18px rgba(140, 82, 255, 0.3);
+}
+
+.site-nav-link-primary:hover,
+.site-nav-link-primary:focus-visible {
+    color: #ffffff;
+    background: linear-gradient(135deg, #9d68ff, #bd6df6);
+    border-color: transparent;
+}
+
+@media (max-width: 900px) {
+    .site-header-inner {
+        gap: 12px;
+    }
+    .site-nav-link {
+        padding-inline: 9px;
+        font-size: 0.8rem;
+    }
+}
+
+@media (max-width: 680px) {
+    .site-header-inner {
+        min-height: 0;
+        flex-wrap: wrap;
+        justify-content: center;
+        gap: 8px 16px;
+        padding-top: 10px;
+        padding-bottom: 10px;
+    }
+    .brand-logo-text-only {
+        width: 100%;
+        justify-content: center;
+    }
+    .site-nav {
+        width: 100%;
+        justify-content: flex-start;
+        overflow-x: auto;
+        padding-bottom: 2px;
+        scrollbar-width: thin;
+    }
+    .site-nav-link {
+        min-height: 34px;
+        padding: 7px 10px;
+        font-size: 0.76rem;
+    }
+}
+
+/* Tek üst menü kullanılır; eski ikinci sekme şeridi ve logo görseli aktif header'da görünmez. */
+.quick-tabs {
+    display: none !important;
+}
+.brand-logo-text-only .brand-logo-image,
+.brand-logo-text-only > img {
+    display: none !important;
+}
