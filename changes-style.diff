+    align-items: center;
+    justify-content: space-between;
+    gap: 24px;
+    margin-top: 30px;
+    padding: 28px;
+    border: 1px solid rgba(140, 82, 255, 0.3);
+    border-radius: 18px;
+    background: linear-gradient(120deg, rgba(76, 29, 149, 0.26), rgba(15, 23, 42, 0.9));
+}
+.guide-callout h2 { margin: 0 0 6px; color: #ffffff; font-size: 1.35rem; }
+.guide-callout p { margin: 0; color: #a5b4fc; line-height: 1.65; }
+@media (max-width: 980px) {
+    .seo-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+    .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (max-width: 680px) {
+    .seo-page-main { padding-top: 48px; }
+    .seo-card-grid,
+    .guide-grid { grid-template-columns: 1fr; }
+    .guide-callout { align-items: flex-start; flex-direction: column; }
+}
